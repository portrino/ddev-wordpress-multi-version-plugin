#!/usr/bin/env bash

## #ddev-generated
## Description: (Re)install the WordPress instances (one Composer project per version) with the plugin required from the project root.
## Usage: install [version|all] [--multisite] [-v|--verbose]
## Example: "ddev install all" or "ddev install 71 --multisite" or "ddev install 7.1 -v"

set -eo pipefail

target="all"
multisite=0
for arg in "$@"; do
    case "$arg" in
        --multisite) multisite=1 ;;
        -v|--verbose) export VERBOSE=1 ;;
        -*) echo "Unknown option '$arg'." >&2; exit 1 ;;
        *) target="$arg" ;;
    esac
done

. .ddev/.setup/scripts/utils.sh

if [ "$target" = "all" ]; then
    versions=$(wp_versions)
else
    versions=$(wp_resolve "$target")
fi
slug=$(wp_plugin_slug)
package=$(wp_package_name)

shopt -s nullglob
fixtures="/var/www/plugin/${FIXTURES_DIR}"
fixture_files=("$fixtures"/*.sql "$fixtures"/*.xml "$fixtures"/*.sh)
xml_fixtures=("$fixtures"/*.xml)
importer=()
[ ${#xml_fixtures[@]} -gt 0 ] && importer=(wpackagist-plugin/wordpress-importer)

for version in $versions; do
    label=$(wp_label "$version")
    path=$(wp_path "$version")
    database="db_${label}"
    url="https://${label}.${DDEV_SITENAME}.${DDEV_TLD}"
    composer=(composer --working-dir="$path" --no-interaction)
    multisite_flag=()
    [ "$multisite" = "1" ] && multisite_flag=(--network)

    message magenta "Installing WordPress ${version} at ${url}"
    cd /var/www/html
    run_hook pre-install

    _progress " ├─ Prepare instance"
        rm -rf "$path"
        mkdir -p "$path/packages/$slug" "$path/public/wp-content/uploads"
        # wp-cli.yml lets `ddev <label> wp …` and the hooks run a plain `wp` in the instance
        printf 'path: public/wp-source\nurl: %s\n' "$url" > "$path/wp-cli.yml"
        # Item by item, so the plugin's own vendor/ stays out and the instance has to resolve its dependencies
        read -r -a exclusions <<< "${SYMLINK_EXCLUSIONS:-}"
        for item in /var/www/plugin/*; do
            for exclusion in "${exclusions[@]}"; do
                [ "$(basename "$item")" = "$exclusion" ] && continue 2
            done
            # Leave out what the release archive leaves out (export-ignore in .gitattributes);
            # without git or a repository everything is linked
            # shortcut: only root entries, a rule for a nested path (/Classes/Debug) doesn't apply
            git -C /var/www/plugin check-attr export-ignore -- "$(basename "$item")" 2>/dev/null \
                | grep -q ': set$' && continue
            ln -s "$item" "$path/packages/$slug/"
        done
        # Local packages (e.g. a child theme), required by name in THEME_PACKAGES or ADDITIONAL_PACKAGES
        for dir in "${FIXTURE_PACKAGE_DIRS[@]}"; do
            for item in "/var/www/plugin/$dir"/*/; do
                if [ -f "$item/composer.json" ]; then
                    ln -s "${item%/}" "$path/packages/"
                fi
            done
        done
        mysql -u"$WP_DB_USERNAME" -p"$WP_DB_PASSWORD" -h"$WP_DB_HOST" \
            -e "DROP DATABASE IF EXISTS \`$database\`; CREATE DATABASE \`$database\`; GRANT ALL ON \`$database\`.* TO 'db'@'%';"
    _done

    _progress " ├─ Install Composer packages"
        export COMPOSER_ROOT_VERSION=1.0.0
        "${composer[@]}" init --name="test/wordpress-${label}" --description="WordPress ${version}" --quiet
        "${composer[@]}" config repositories.plugin path 'packages/*'
        "${composer[@]}" config repositories.wpackagist '{"type": "composer", "url": "https://wpackagist.org", "only": ["wpackagist-plugin/*", "wpackagist-theme/*"]}'
        "${composer[@]}" config allow-plugins.composer/installers true
        "${composer[@]}" config allow-plugins.roots/wordpress-core-installer true
        # Old WordPress versions have advisories, which must not block a test instance
        "${composer[@]}" config audit.block-insecure false
        for entry in "${COMPOSER_CONFIG[@]}"; do
            # Unquoted on purpose: each entry is "<key> <value...>"
            "${composer[@]}" config $entry
        done
        "${composer[@]}" config extra.wordpress-install-dir public/wp-source
        "${composer[@]}" config --json extra.installer-paths '{
            "public/wp-content/mu-plugins/{$name}/": ["type:wordpress-muplugin"],
            "public/wp-content/plugins/{$name}/": ["type:wordpress-plugin"],
            "public/wp-content/themes/{$name}/": ["type:wordpress-theme"]
        }'
        "${composer[@]}" require --no-progress \
            "roots/wordpress:~${version}.0" composer/installers "${package}:*@dev" \
            "${THEME_PACKAGES[@]}" "${ADDITIONAL_PACKAGES[@]}" "${importer[@]}"
    _done

    cd "$path"
    run_hook post-composer

    _progress " ├─ Set up WordPress"
        printf "<?php\n// Generated by ddev install\ndefine('WP_USE_THEMES', true);\nrequire __DIR__ . '/wp-source/wp-blog-header.php';\n" > "$path/public/index.php"
        cat > "$path/public/wp-config.php" <<PHP
<?php
// Generated by ddev install. Credentials come from the container environment
// (.ddev/docker-compose.wordpress-setup.yaml, override in docker-compose.zz-project.yaml).
require_once dirname(__DIR__) . '/vendor/autoload.php';

define('DB_NAME', '${database}');
define('DB_USER', getenv('WP_DB_USERNAME'));
define('DB_PASSWORD', getenv('WP_DB_PASSWORD'));
define('DB_HOST', getenv('WP_DB_HOST'));
define('DB_CHARSET', 'utf8mb4');
define('DB_COLLATE', '');
\$table_prefix = 'wp_';

define('WP_HOME', '${url}');
define('WP_SITEURL', WP_HOME . '/wp-source');
define('WP_CONTENT_DIR', __DIR__ . '/wp-content');
define('WP_CONTENT_URL', WP_HOME . '/wp-content');
// The webserver also serves /wp-admin from wp-source, the default /wp-source/wp-admin cookie wouldn't reach it
define('ADMIN_COOKIE_PATH', '/');

define('WP_ENVIRONMENT_TYPE', 'local');
define('WP_DEBUG', true);
define('WP_DEBUG_LOG', true);
define('WP_DEBUG_DISPLAY', false);
// Each instance must stay on its version, background updates would move it to the latest release
define('AUTOMATIC_UPDATER_DISABLED', true);

/* That's all, stop editing! Happy publishing. */

if (!defined('ABSPATH')) {
    define('ABSPATH', __DIR__ . '/wp-source/');
}
require_once ABSPATH . 'wp-settings.php';
PHP
        wp config shuffle-salts --quiet

        install_args=(--title="${slug} (WordPress ${version})" --admin_user="$WP_SETUP_ADMIN_USERNAME" --admin_password="$WP_SETUP_ADMIN_PASSWORD" --admin_email="$WP_SETUP_ADMIN_EMAIL" --skip-email --quiet)
        if [ "$multisite" = "1" ]; then
            wp core multisite-install "${install_args[@]}"
            wp theme enable "$THEME" --network --quiet
        else
            wp core install "${install_args[@]}"
        fi
        wp theme activate "$THEME" --quiet
        # The plugin and everything from ADDITIONAL_PACKAGES; deactivate exceptions in a hook
        wp plugin activate --all "${multisite_flag[@]}" --quiet
    _done

    run_hook post-wp-setup

    if [ ${#fixture_files[@]} -gt 0 ]; then
        _progress " ├─ Import fixtures"
            for file in "$fixtures"/*.sql; do
                message yellow "Importing $(basename "$file")"
                wp db import "$file" --quiet
            done
            for file in "$fixtures"/*.xml; do
                message yellow "Importing $(basename "$file")"
                wp import "$file" --authors=create --quiet
            done
            # Best effort: a failing script is reported, not fatal
            for file in "$fixtures"/*.sh; do
                message yellow "Running $(basename "$file")"
                WP_VERSION="$version" WP_LABEL="$label" WP_URL="$url" WP_MULTISITE="$multisite" \
                    bash "$file" || message red "Fixture script $(basename "$file") failed (continuing)"
            done
        _done
    fi

    run_hook post-install

    printf " └─ \e[33mWordPress %s ready:\e[0m %s/wp-admin/ (%s / %s)\n" "$version" "$url" "$WP_SETUP_ADMIN_USERNAME" "$WP_SETUP_ADMIN_PASSWORD"
done
