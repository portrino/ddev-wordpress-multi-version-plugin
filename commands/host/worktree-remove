#!/usr/bin/env bash

## #ddev-generated
## Description: Delete this git worktree's DDEV project (database, images, volumes) and print the git commands that remove the worktree.
## Usage: worktree-remove
## Example: "ddev worktree-remove"

set -eo pipefail

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "Not a git repository." >&2
    exit 1
fi
git_dir="$(cd "$(git rev-parse --git-dir)" && pwd -P)"
common_dir="$(cd "$(git rev-parse --git-common-dir)" && pwd -P)"
if [ "$git_dir" = "$common_dir" ]; then
    echo "Run this in a linked git worktree, not in the primary checkout." >&2
    exit 1
fi

worktree_path="$(pwd)"
branch="$(git rev-parse --abbrev-ref HEAD)"

echo "Deleting DDEV project '${DDEV_PROJECT}' (database, images, volumes)..."
ddev delete -Oy

echo ""
echo "A worktree can't remove itself. From the PRIMARY checkout, run:"
echo ""
echo "  git worktree remove --force '${worktree_path}'"
echo "  git branch -D '${branch}'"
