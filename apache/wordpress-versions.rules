#ddev-generated
# Shared by both vhosts in wordpress-versions.conf. Does what WordPress' .htaccess
# does (including subdirectory multisite), so no instance needs one.

DocumentRoot /var/www/html/.Build
<Directory "/var/www/html/.Build">
    AllowOverride None
    Require all granted
    DirectoryIndex index.php
</Directory>

SetEnvIf X-Forwarded-Proto "https" HTTPS=on
ErrorLog /dev/stdout
CustomLog ${APACHE_LOG_DIR}/access.log combined
LimitRequestFieldSize 16380

RewriteEngine On

RewriteCond %{HTTP_HOST} ^([0-9]+)\.
RewriteRule ^ - [E=WP_ROOT:/var/www/html/.Build/%1]
RewriteCond %{ENV:WP_ROOT} ^$
RewriteRule ^ - [F]

# Directories without trailing slash, and /<site>/wp-admin. DDEV terminates TLS in
# the router, so mod_dir's own redirect would point to http.
RewriteCond %{ENV:WP_ROOT}%{REQUEST_URI} -d [OR]
RewriteCond %{REQUEST_URI} ^/[_0-9a-zA-Z-]+/wp-admin$
RewriteRule ^(.*[^/])$ https://%{HTTP_HOST}$1/ [R=301,L]

# Existing files and directories as they are
RewriteCond %{ENV:WP_ROOT}%{REQUEST_URI} -f [OR]
RewriteCond %{ENV:WP_ROOT}%{REQUEST_URI} -d
RewriteRule ^(.*)$ %{ENV:WP_ROOT}$1 [L]

# Subdirectory multisite: /<site>/wp-* and /<site>/*.php come from the instance root
RewriteRule ^/[_0-9a-zA-Z-]+(/wp-(content|admin|includes).*)$ %{ENV:WP_ROOT}$1 [L]
RewriteRule ^/[_0-9a-zA-Z-]+(/.*\.php)$ %{ENV:WP_ROOT}$1 [L]

RewriteRule ^ %{ENV:WP_ROOT}/index.php [L]
